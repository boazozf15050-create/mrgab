    local function findCuffTool()
        local cuffCharacter = localPlayer.Character
        if not cuffCharacter then
            return nil
        end
        local backpack = localPlayer:FindFirstChildOfClass("Backpack")
        local bestTool = nil
        local bestScore = 0
        local function scoreCuffTool(tool)
            if not tool or not tool:IsA("Tool") then
                return 0
            end
            local toolName = tostring(tool.Name or ""):lower()
            local toolScore = 0
            if
                toolName:find("cuff", 1, true)
                or toolName:find("handcuff", 1, true)
                or toolName:find("arrest", 1, true)
                or toolName:find("كلب", 1, true)
            then
                toolScore = toolScore + 4
            end
            for toolDescIndex, toolDescendant in ipairs(tool:GetDescendants()) do
                if toolDescendant:IsA("RemoteEvent") or toolDescendant:IsA("RemoteFunction") then
                    local remoteName = tostring(toolDescendant.Name or ""):lower()
                    if
                        remoteName:find("cuff", 1, true)
                        or remoteName:find("arrest", 1, true)
                        or remoteName:find("handcuff", 1, true)
                    then
                        toolScore = toolScore + 5
                    else
                        toolScore = toolScore + 1
                    end
                end
            end
            return toolScore
        end
        for equippedIndex, equippedTool in ipairs(cuffCharacter:GetChildren()) do
            local equippedScore = scoreCuffTool(equippedTool)
            if equippedScore > bestScore then
                bestScore = equippedScore
                bestTool = equippedTool
            end
        end
        if not bestTool and backpack then
            for backpackIndex, backpackTool in ipairs(backpack:GetChildren()) do
                local backpackScore = scoreCuffTool(backpackTool)
                if backpackScore > bestScore then
                    bestScore = backpackScore
                    bestTool = backpackTool
                end
            end
        end
        return bestTool
    end
    local function getCuffTarget()
        if selectedCuffTarget and selectedCuffTarget.Parent then
            return selectedCuffTarget
        end
        local targetQuery = cuffSearchBox.Text:lower():gsub("%s+", "")
        if targetQuery ~= "" then
            for nearIndex, nearCandidate in ipairs(players:GetPlayers()) do
                if
                    (nearCandidate ~= localPlayer)
                    and (
                        (nearCandidate.Name:lower() == targetQuery)
                        or (nearCandidate.DisplayName:lower() == targetQuery)
                    )
                then
