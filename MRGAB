do
    local function getHumanoidRootPart(playerArg)
        if not playerArg then
            return nil
        end
        local rootPart = playerArg:FindFirstChild("HumanoidRootPart")
        if rootPart then
            return rootPart
        else
            local lookupParams = {
                pcall(function()
                    return playerArg:WaitForChild("HumanoidRootPart", 2)
                end),
            }
            if lookupParams[1] then
                return lookupParams[2]
            else
                return nil
            end
        end
    end
    local hangProtectEnabled = false
    local hangAnchorPosition
    hangProtectButton.MouseButton1Click:Connect(function()
        hangProtectEnabled = not hangProtectEnabled
        if hangProtectEnabled then
            local hangRoot = getHumanoidRootPart(localPlayer.Character)
            hangAnchorPosition = (hangRoot and hangRoot.Position) or nil
            hangProtectButton.Text = "إيقاف حماية"
            hangProtectButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            hangProtectButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            hangProtectButton.Text = "حماية تعليق"
            hangProtectButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            hangProtectButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            hangAnchorPosition = nil
        end
    end)
    localPlayer.CharacterAdded:Connect(function(addedCharacter)
        local trackedRoot = getHumanoidRootPart(addedCharacter)
        if hangProtectEnabled and trackedRoot then
            hangAnchorPosition = hangAnchorPosition or trackedRoot.Position
        end
    end)
    runService.Heartbeat:Connect(function()
        if not hangProtectEnabled or not hangAnchorPosition then
            return
        end
        local voidCharacter = localPlayer.Character
        local voidRoot = getHumanoidRootPart(voidCharacter)
        if not voidRoot then
            return
        end
        pcall(function()
            if (voidRoot.Position - hangAnchorPosition).Magnitude > 10000 then
                voidRoot.CFrame = CFrame.new(hangAnchorPosition)
                local voidHumanoid = voidCharacter:FindFirstChildOfClass("Humanoid")
                if voidHumanoid then
                    voidHumanoid.PlatformStand = true
                    task.delay(2, function()
                        if voidCharacter and voidCharacter.Parent and voidHumanoid then
                            voidHumanoid.PlatformStand = false
                        end
                    end)
                end
            end
        end)
    end)

    voidPageScroll:ClearAllChildren()
    voidPage = Instance.new("Frame")
end
