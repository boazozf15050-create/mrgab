        local localOrigin = cuffLocalCharacter.HumanoidRootPart.Position
        local nearestPlayer, nearestDistance = nil, 500
        for nearestIndex, nearPlayer in ipairs(players:GetPlayers()) do
            if
                (nearPlayer ~= localPlayer)
                and nearPlayer.Character
                and nearPlayer.Character:FindFirstChild("HumanoidRootPart")
            then
                local candidateDistance = (localOrigin - nearPlayer.Character.HumanoidRootPart.Position).Magnitude
                if candidateDistance < nearestDistance then
                    nearestDistance = candidateDistance
                    nearestPlayer = nearPlayer
                end
            end
