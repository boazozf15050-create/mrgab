        for cuffDescIndex, cuffDescendant in ipairs(cuffTool:GetDescendants()) do
            if cuffDescendant:IsA("RemoteEvent") or cuffDescendant:IsA("RemoteFunction") then
                local cuffDescName = tostring(cuffDescendant.Name or ""):lower()
                local cuffDescCount = 1
                if
                    cuffDescName:find("cuff", 1, true)
                    or cuffDescName:find("arrest", 1, true)
                    or cuffDescName:find("handcuff", 1, true)
                then
                    cuffDescCount = 5
                end
                if cuffDescCount > partScore then
                    nearestPart = cuffDescendant
                    partScore = cuffDescCount
                end
