local function makeDraggable(draggableFrame)
    local isDraggingWindow = false
    local dragWindowStart = (Vector3.new(0, 0, 0))
    local dragWindowFrameStart = (Vector3.new(0, 0, 0))
    local function updateWindowDrag(moveInput)
        local moveDelta = moveInput.Position - dragWindowStart
        local viewportSize = game.Workspace.CurrentCamera.ViewportSize
        local frameSize = draggableFrame.AbsoluteSize
        local clampedX = math.clamp(dragWindowFrameStart.X + moveDelta.X, 0, viewportSize.X - frameSize.X)
        draggableFrame.Position = (
            UDim2.new(0, clampedX, 0, math.clamp(dragWindowFrameStart.Y + moveDelta.Y, 0, viewportSize.Y - frameSize.Y))
        )
    end
    draggableFrame.InputBegan:Connect(function(dragBeganInput)
        if
            (dragBeganInput.UserInputType == Enum.UserInputType.MouseButton1)
            or (dragBeganInput.UserInputType == Enum.UserInputType.Touch)
        then
            isDraggingWindow = true
            dragWindowStart = dragBeganInput.Position
            dragWindowFrameStart = (
                Vector3.new(draggableFrame.AbsolutePosition.X, draggableFrame.AbsolutePosition.Y, 0)
            )
            dragBeganInput.Changed:Connect(function()
                if dragBeganInput.UserInputState == Enum.UserInputState.End then
                    isDraggingWindow = false
                end
            end)
        end
    end)
    local activeDragInput
    draggableFrame.InputChanged:Connect(function(dragMoveInput)
        if
            (dragMoveInput.UserInputType == Enum.UserInputType.MouseMovement)
            or (dragMoveInput.UserInputType == Enum.UserInputType.Touch)
        then
            activeDragInput = dragMoveInput
        end
    end)
    userInputService.InputChanged:Connect(function(dragChangedInput)
        if isDraggingWindow and (dragChangedInput == activeDragInput) then
            updateWindowDrag(dragChangedInput)
        end
    end)
end

