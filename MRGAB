    local matches = {}
    local prefixLower = string.lower(prefix)
    for prefixIndex, prefixPlayer in ipairs(players:GetPlayers()) do
        if prefixPlayer ~= localPlayer then
            local nameLower = string.lower(prefixPlayer.Name)
            local displayLower = string.lower(prefixPlayer.DisplayName or "")
            local nameMatches = (string.sub(nameLower, 1, #prefixLower)) == prefixLower
            local prefixMatches = nameMatches
                or ((displayLower ~= "") and ((string.sub(displayLower, 1, #prefixLower)) == prefixLower))
            if prefixMatches then
                table.insert(
                    matches,
                    { name = prefixPlayer.Name, display = prefixPlayer.DisplayName, userId = prefixPlayer.UserId }
                )
            end
        end
    end
    table.sort(matches, function(sortPlayerA, sortPlayerB)
        return (string.lower(sortPlayerA.name)) < (string.lower(sortPlayerB.name))
    end)
    return matches
end
